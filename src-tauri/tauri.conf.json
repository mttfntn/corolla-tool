{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corolla",
  "version": "0.3.0",
  "identifier": "com.corolla.converter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "wheel",
        "title": "Corolla",
        "url": "index.html",
        "width": 640,
        "height": 640,
        "x": -20000,
        "y": -20000,
        "visible": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Matteo Fontana",
    "copyright": "© Matteo Fontana. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
